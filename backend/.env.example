# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_SESSION_TOKEN=AQoDYXdzEJr1... (obligatorio si usas AWS Academy / Learner Lab / SSO)
